{
  "name": "driftwing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Race and explore on wyvernback across a floating archipelago.",
  "scripts": {
    "dev": "vite",
    "windhaven": "vite --host 127.0.0.1 --port 5174 --strictPort --open /?view=windhaven",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rider-qa": "vitest run --config scripts/rider-qa.config.mjs --maxWorkers=1",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "test:windhaven": "node scripts/windhaven-smoke.mjs http://127.0.0.1:5174"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/marcellus": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "simplex-noise": "^4.0.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.56.1",
    "typescript": "^6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
